drop database if exists fts_tokenize_hot_path;
create database fts_tokenize_hot_path;
use fts_tokenize_hot_path;
set ob_query_timeout = 10000000000;
create table docs (
id bigint auto_increment primary key,
title varchar(256) not null,
content text not null,
title_en varchar(256) not null,
content_en text not null,
fulltext index fti_all(title, content) with parser ik,
fulltext index fti_en(title_en, content_en) with parser beng
) default charset = utf8mb4;
insert into docs (title, content, title_en, content_en) values
('数据库性能优化实践', '全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例、内存池化数据结构等技术。', 'Database performance audit', 'Full-text search indexing requires efficient tokenization on the hot path.'),
('全文索引分词器', '倒排索引是全文检索的核心数据结构，分词质量直接影响查询延迟。', 'Inverted index build', 'Inverted index build performance and query latency under heavy load.'),
('海洋基地', 'OceanBase是一款非常稳定的数据库，支持多种内置分词器。', 'OceanBase stability', 'OceanBase is a stable database with several built in parsers.'),
('英文标题', 'The quick brown fox jumps over the lazy dog.', 'Mixed document', 'Mixed 文档 row=3 for MATCH and TOKENIZE.');
result_format: 4
select tokenize('OceanBase是一款非常稳定的数据库', 'ik');
+------------------------------------------------------------------------+
| tokenize('OceanBase是一款非常稳定的数据库', 'ik')                      |
+------------------------------------------------------------------------+
| ["非常", "oceanbase", "稳定", "是", "数据库", "的", "一款"]            |
+------------------------------------------------------------------------+
select tokenize('OceanBase是一款非常稳定的数据库', 'ik', '[]');
+------------------------------------------------------------------------+
| tokenize('OceanBase是一款非常稳定的数据库', 'ik', '[]')                |
+------------------------------------------------------------------------+
| ["非常", "oceanbase", "稳定", "是", "数据库", "的", "一款"]            |
+------------------------------------------------------------------------+
select tokenize('OceanBase是一款非常稳定的数据库', 'ik', '[{"output": "default"}]');
+-----------------------------------------------------------------------------------------+
| tokenize('OceanBase是一款非常稳定的数据库', 'ik', '[{"output": "default"}]')            |
+-----------------------------------------------------------------------------------------+
| ["非常", "oceanbase", "稳定", "是", "数据库", "的", "一款"]                             |
+-----------------------------------------------------------------------------------------+

select tokenize('中华人民共和国人民大会堂', 'ik', '[{"output": "all"}]');
+----------------------------------------------------------------------------------+
| tokenize('中华人民共和国人民大会堂', 'ik', '[{"output": "all"}]')                |
+----------------------------------------------------------------------------------+
| {"tokens": [{"人民大会堂": 1}, {"中华人民共和国": 1}], "doc_len": 2}             |
+----------------------------------------------------------------------------------+
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"output": "all"}, {"output": "default"}]');
+------------------------------------------------------------------------------------------------------+
| tokenize('中华人民共和国人民大会堂', 'ik', '[{"output": "all"}, {"output": "default"}]')             |
+------------------------------------------------------------------------------------------------------+
| ["人民大会堂", "中华人民共和国"]                                                                     |
+------------------------------------------------------------------------------------------------------+

select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]');
+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]')                                                                                                  |
+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| ["大会", "人民大会堂", "大会堂", "共和国", "人民大会", "人民共和国", "中华人民", "共和", "会堂", "中华", "中华人民共和国", "国人", "华人", "人民"]                                              |
+-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}, {"output": "all"}]');
+----------------------------------------------------------------------------------------------------------------------------+
| tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}, {"output": "all"}]')             |
+----------------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"人民大会堂": 1}, {"中华人民共和国": 1}], "doc_len": 2}                                                       |
+----------------------------------------------------------------------------------------------------------------------------+

select tokenize('The quick brown fox', 'beng');
+-----------------------------------------+
| tokenize('The quick brown fox', 'beng') |
+-----------------------------------------+
| ["quick", "brown", "fox"]               |
+-----------------------------------------+
select tokenize('The quick brown fox', 'space');
+------------------------------------------+
| tokenize('The quick brown fox', 'space') |
+------------------------------------------+
| ["quick", "brown", "fox"]                |
+------------------------------------------+
select tokenize('The quick brown fox', 'ngram');
+--------------------------------------------------------------------------+
| tokenize('The quick brown fox', 'ngram')                                 |
+--------------------------------------------------------------------------+
| ["th", "ox", "fo", "he", "ow", "ck", "wn", "ic", "br", "ui", "ro", "qu"] |
+--------------------------------------------------------------------------+
select tokenize('The quick brown fox', 'ngram2');
+----------------------------------------------------------------------------------------------------------------------------------+
| tokenize('The quick brown fox', 'ngram2')                                                                                        |
+----------------------------------------------------------------------------------------------------------------------------------+
| ["th", "qui", "ox", "fo", "he", "row", "ow", "ck", "bro", "wn", "ic", "own", "br", "ick", "fox", "ui", "ro", "qu", "uic", "the"] |
+----------------------------------------------------------------------------------------------------------------------------------+
select tokenize('hello 中文 world 123', 'space', '[{"output": "all"}]');
+--------------------------------------------------------------------+
| tokenize('hello 中文 world 123', 'space', '[{"output": "all"}]')   |
+--------------------------------------------------------------------+
| {"tokens": [{"123": 1}, {"world": 1}, {"hello": 1}], "doc_len": 3} |
+--------------------------------------------------------------------+

select tokenize('', 'ik');
+--------------------+
| tokenize('', 'ik') |
+--------------------+
| []                 |
+--------------------+
select tokenize('a', 'ik');
+---------------------+
| tokenize('a', 'ik') |
+---------------------+
| ["a"]               |
+---------------------+
select tokenize('a', 'ik', '[]');
+---------------------------+
| tokenize('a', 'ik', '[]') |
+---------------------------+
| ["a"]                     |
+---------------------------+
select tokenize('数据库', 'ik');
+-----------------------------+
| tokenize('数据库', 'ik')    |
+-----------------------------+
| ["数据库"]                  |
+-----------------------------+
select tokenize('IK分词器 ik-smart 3.14 v2.0 测试O2O', 'ik');
+------------------------------------------------------------------+
| tokenize('IK分词器 ik-smart 3.14 v2.0 测试O2O', 'ik')            |
+------------------------------------------------------------------+
| ["3.14", "o2o", "ik-smart", "v2.0", "分词器", "ik", "测试"]      |
+------------------------------------------------------------------+
select tokenize('数据库性能优化实践 / Database performance audit', 'ik', '[{"output": "all"}]');
+----------------------------------------------------------------------------------------------------------------------------------------------+
| tokenize('数据库性能优化实践 / Database performance audit', 'ik', '[{"output": "all"}]')                                                     |
+----------------------------------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"性能": 1}, {"audit": 1}, {"database": 1}, {"优化": 1}, {"performance": 1}, {"实践": 1}, {"数据库": 1}], "doc_len": 7}          |
+----------------------------------------------------------------------------------------------------------------------------------------------+

select count(*) from docs where match(title, content) against('全文索引');
+----------+
| count(*) |
+----------+
|        2 |
+----------+
select count(*) from docs where match(title, content) against('数据库 分词器');
+----------+
| count(*) |
+----------+
|        3 |
+----------+
select count(*) from docs where match(title_en, content_en) against('database build');
+----------+
| count(*) |
+----------+
|        3 |
+----------+
select count(*) from docs where match(title, content) against('倒排索引 tokenizer');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
select count(*) from docs where match(title, content) against('not_exist_token');
+----------+
| count(*) |
+----------+
|        0 |
+----------+
select id from docs where match(title, content) against('数据库') order by id;
+----+
| id |
+----+
|  1 |
|  3 |
+----+

select id, round(match(title, content) against('数据库 分词器'), 6) as r
  from docs where match(title, content) against('数据库 分词器') order by r desc, id;
+----+----------+
| id | r        |
+----+----------+
|  3 | 0.445344 |
|  1 | 0.309859 |
|  2 | 0.207547 |
+----+----------+

select count(*) from docs where match(title, content) against('+数据库 -倒排索引' in boolean mode);
+----------+
| count(*) |
+----------+
|        2 |
+----------+

drop database fts_tokenize_hot_path;
